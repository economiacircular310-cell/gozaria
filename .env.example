# Copia este archivo como .env y rellena los valores. No subas .env a ningún repositorio.

# --- Aplicación ---
GOSARIA_ENV=production
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SITE_URL=https://gosariapamplona.es

# --- Panel /admin ---
# Genera el hash con:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('tu-contraseña'))"
ADMIN_PASSWORD_HASH=
# Solo en desarrollo (en producción se ignora):
# ADMIN_PASSWORD=gosaria

# --- Correo de los formularios (Microsoft 365 de GoDaddy) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=contacto@gosariapamplona.es
SMTP_PASSWORD=
MAIL_FROM=contacto@gosariapamplona.es
MAIL_TO=contacto@gosariapamplona.es

# --- Analítica (opcional; solo se carga si el visitante la acepta) ---
GA_MEASUREMENT_ID=

# --- Datos del negocio (si se dejan vacíos, la web no los muestra) ---
NEGOCIO_TELEFONO=
NEGOCIO_WHATSAPP=
NEGOCIO_GLOVO=
NEGOCIO_FACEBOOK=
NEGOCIO_TIKTOK=
# Enlace directo para escribir una reseña en Google (Perfil de Empresa > Pedir reseñas).
# Si se deja vacío, el botón «Escribir una reseña» lleva a la ficha de Google Maps.
NEGOCIO_GOOGLE_RESENA=
# Cierres excepcionales separados por comas: 2026-12-25,2027-01-01
NEGOCIO_CIERRES=
SALA_AFORO=

# --- Titular (aviso legal y privacidad) ---
TITULAR_RAZON_SOCIAL=
TITULAR_NIF=
TITULAR_DOMICILIO=Plaza Salesianos, 8, 31002 Pamplona (Navarra)
TITULAR_EMAIL=contacto@gosariapamplona.es
TITULAR_REGISTRO=
HOSTING_PROVEEDOR=
