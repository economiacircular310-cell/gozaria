# Configuración para la demo en subdominio. instalar.sh rellena SECRET_KEY, SITE_URL y
# ADMIN_PASSWORD_HASH automáticamente. El resto se puede editar después en
# /srv/gosaria-web/.env y aplicar con: sudo systemctl restart gosaria

GOSARIA_ENV=production
SECRET_KEY=
SITE_URL=https://demo.ejemplo.com
# Demo: Google no indexa ninguna página (noindex en todas)
NOINDEX_SITIO=1

ADMIN_PASSWORD_HASH=

# Correo de los formularios. En la demo se deja vacío: los mensajes se ven en /admin/mensajes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=contacto@gosariapamplona.es
MAIL_TO=contacto@gosariapamplona.es

GA_MEASUREMENT_ID=

NEGOCIO_TELEFONO=
NEGOCIO_WHATSAPP=
NEGOCIO_GLOVO=
NEGOCIO_FACEBOOK=
NEGOCIO_TIKTOK=
NEGOCIO_GOOGLE_RESENA=
NEGOCIO_CIERRES=
SALA_AFORO=

TITULAR_RAZON_SOCIAL=
TITULAR_NIF=
TITULAR_DOMICILIO=Plaza Salesianos, 8, 31002 Pamplona (Navarra)
TITULAR_EMAIL=contacto@gosariapamplona.es
TITULAR_REGISTRO=
HOSTING_PROVEEDOR=
